GOVERNMENT_OCR_SEMANTIC_PREFIX_MIN_TOKENS=6
GOVERNMENT_OCR_SEMANTIC_POSITION_MATCH_RATIO=0.72
GOVERNMENT_OCR_SEMANTIC_TAIL_MATCH_RATIO=0.75
GOVERNMENT_OCR_SEMANTIC_MATERIAL_SIMILARITY=0.72
GOVERNMENT_OCR_TESSERACT_VERIFIER_ENABLED=true
GOVERNMENT_OCR_TESSERACT_EXECUTABLE_PATH=tools/tesseract/tesseract.exe
GOVERNMENT_OCR_TESSERACT_DATA_PATH=tools/tesseract/tessdata_best
GOVERNMENT_OCR_TESSERACT_LANGUAGES=vie+eng
GOVERNMENT_OCR_TESSERACT_PAGE_SEGMENTATION_MODE=3
GOVERNMENT_OCR_TESSERACT_TIMEOUT_SECONDS=60
GOVERNMENT_OCR_TESSERACT_FAIL_CLOSED=true
GOVERNMENT_OCR_TESSERACT_MIN_CONFIDENCE=0.80
GOVERNMENT_OCR_TESSERACT_LINE_MATCH_SCORE=0.55
GOVERNMENT_OCR_TESSERACT_MATERIAL_SIMILARITY=0.55

# Performance-regression diagnostics (wall/process CPU, RSS, CPU frequency, thread pools, workload fingerprint).
GOVERNMENT_OCR_PERFORMANCE_DIAGNOSTICS_ENABLED=true

# Layout OCR scan 1.3.5.4
GOVERNMENT_OCR_OCR_COLUMN_OCCUPANCY_THRESHOLD=0.14
GOVERNMENT_OCR_OCR_COLUMN_MIN_GAP_RATIO=0.03
