# Independent PP-OCRv5 Latin verifier. Enabled for semantic comparison only.
GOVERNMENT_OCR_SECONDARY_RECOGNIZER_ENABLED=true
GOVERNMENT_OCR_SECONDARY_RECOGNIZER_MODEL_NAME=latin_PP-OCRv5_mobile_rec
GOVERNMENT_OCR_SECONDARY_RECOGNIZER_MIN_CONFIDENCE=0.65
GOVERNMENT_OCR_SECONDARY_RECOGNIZER_PREFERENCE_MARGIN=0.08
GOVERNMENT_OCR_SECONDARY_RECOGNIZER_APPLY_CHANGES=false

# Semantic-safe output. Secondary OCR may validate deletion of a strict,
# non-numeric hallucinated suffix; it never supplies replacement text.
GOVERNMENT_OCR_SEMANTIC_VERIFICATION_ENABLED=true
# Run PP-OCRv5 only for lines flagged by VietOCR/Tesseract. If Tesseract is
# disabled, every unchecked line is still sent to PP-OCRv5 (fail-safe mode).
GOVERNMENT_OCR_SEMANTIC_SELECTIVE_VERIFICATION_ENABLED=true
GOVERNMENT_OCR_SEMANTIC_AUTO_TRIM_ENABLED=true
GOVERNMENT_OCR_SEMANTIC_SECONDARY_MIN_CONFIDENCE=0.90
GOVERNMENT_OCR_SEMANTIC_PRIMARY_LOW_CONFIDENCE=0.62
